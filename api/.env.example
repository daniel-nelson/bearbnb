DB_USER=<db-user>
DB_PASSWORD='<db-password>'
DB_NAME=bearbnb_development
DB_PORT=5432
DB_HOST='localhost'
REPLICA_DB_PORT=5432
REPLICA_DB_HOST='localhost'
DB_NO_SSL=1
APP_ENCRYPTION_KEY='<paste the results of runnning: pnpm psy g:encryption-key>'
COLUMN_ENCRYPTION_KEY='<paste the results of runnning: pnpm psy g:encryption-key>'
WEB_SERVICE=1
WORKER_SERVICE=1
CORS_HOSTS='["http://localhost:3000", "http://localhost:3001", "http://localhost:3002"]'
CLIENT_APP_HOST='http://localhost:3000'
ADMIN_APP_HOST='http://localhost:3001'
INTERNAL_APP_HOST='http://localhost:3002'
FIREBASE_PROJECT_ID='demo-bearbnb'
# Local development only; stage/prod authenticated requests reject Firebase Auth emulator tokens.
FIREBASE_AUTH_EMULATOR_HOST='127.0.0.1:9099'
TZ=UTC
