# SECURITY — pin the registry so installs can't be silently redirected to a
# malicious mirror.
registry=https://registry.npmjs.org
@rvoh:registry=https://registry.npmjs.org

# Supply-chain cooldown and dependency build-script blocking are configured in
# pnpm-workspace.yaml (minimumReleaseAge + the default script-block), which is
# where pnpm reads them.
